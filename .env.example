# Copy this file as .env.test and fill in the values:
#   cp .env.example .env.test
# The ENV variable decides which file is read (.env.<ENV>), default "test".

BASE_URL=https://www.e-bebek.com
API_BASE_URL=https://api2.e-bebek.com

# OAuth client used by api/authApi.js. The values below are the public SAP
# Commerce (Spartacus) defaults; in a real project every environment has its own
# pair and they come from a secret store, never from the repository.
API_CLIENT_ID=trusted_client
API_CLIENT_SECRET=secret

# Required for scenarios tagged @auth. If left empty, those scenarios are
# automatically marked "skipped" (features/support/hooks.js).
EBEBEK_EMAIL=
EBEBEK_PASSWORD=

# chromium | firefox | webkit
BROWSER=chromium

# Set to false to open the browser in headed mode (for local debugging).
HEADLESS=true

PARALLEL_WORKERS=2
DEFAULT_TIMEOUT_MS=30000
